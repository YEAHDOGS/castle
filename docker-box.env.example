# Settings for Castle in Docker. Copy this file to ".env" in the same folder and change
# what you need; then:  docker compose up -d --build

# The vault the box starts on: a folder on the computer that runs Docker (its own SSD,
# say). The folder is made if it is missing.
CASTLE_VAULT=./vault

# Bigger drives. Each is written as <where it is on the computer>:/drives/<a name>, and
# shows up in the app under Settings > Storage, where one press moves Castle's storage to
# it (into a folder named Castle on that drive). Two can be named here.
#
#   A USB drive on Windows (drive letter F:)     CASTLE_DRIVE_1=F:/:/drives/big
#   A USB drive on Linux, mounted at /mnt/big    CASTLE_DRIVE_1=/mnt/big:/drives/big
#
# On Linux, mount the drive by its label or UUID in /etc/fstab (with "nofail"), so it is
# at the same place after every reboot and the computer still starts without it. If the
# drive is missing when Castle starts, Castle says so and uses CASTLE_VAULT until it is back.
# CASTLE_DRIVE_1=F:/:/drives/big
# CASTLE_DRIVE_2=

# A folder of films, shows, music and photos for Theater. Castle only reads it.
# Leave it out and Theater sees the vault.
# CASTLE_MEDIA=E:/Media

# The port Castle answers on, and which of this computer's addresses it answers on.
# 0.0.0.0 is every address (the home network can reach it); 127.0.0.1 is this computer only.
CASTLE_PORT=8787
CASTLE_ADDRESS=0.0.0.0
